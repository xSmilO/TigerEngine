PROJECT_NAME           = TigerEngine
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "A small C++17 2D graphics engine"
OUTPUT_DIRECTORY       = docs/generated
INPUT                  = include src/main.cpp docs/EngineGuide.md docs/Input.md docs/api.dox
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp *.md *.dox
EXCLUDE                = include/Scene/Renderer2D.h
USE_MDFILE_AS_MAINPAGE  = docs/EngineGuide.md
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
INLINE_INHERITED_MEMB  = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = YES
